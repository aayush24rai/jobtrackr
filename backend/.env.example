# PostgreSQL connection string (on Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@localhost:5432/jobtrackr

# JWT signing key - generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# use a different value in production than locally
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# comma-separated frontend origins allowed by CORS, no trailing slashes
ALLOWED_ORIGINS=http://localhost:5173
